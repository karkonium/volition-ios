{
  "name": "volition",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean --platform ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "jest --runInBand",
    "postinstall": "node Scripts/patch-expo-headers.cjs && python3 Scripts/link-native-sources.py",
    "format": "prettier --write . && npm run format:swift && npm run format:python",
    "format:check": "prettier --check . && npm run format:swift:check && npm run format:python:check",
    "format:swift": "node Scripts/format-swift.cjs",
    "format:swift:check": "node Scripts/format-swift.cjs --check",
    "format:python": "uvx ruff@0.17.3 format Scripts",
    "format:python:check": "uvx ruff@0.17.3 format --check Scripts"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@itsRares/ahhzo-elements": "0.8.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "^23.8.8",
    "@react-native-firebase/app": "^23.8.8",
    "@react-native-firebase/crashlytics": "^23.8.8",
    "@react-navigation/bottom-tabs": "^7.3.3",
    "@react-navigation/native": "^7.0.19",
    "@react-navigation/stack": "^7.2.3",
    "@reduxjs/toolkit": "^2.6.1",
    "date-fns": "^4.1.0",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-checkbox": "~57.0.0",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-loader": "~57.0.1",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-screen-orientation": "~57.0.3",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "i18next": "^25.10.10",
    "punycode": "^2.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^15.7.4",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
