    "@types/react": "~19.2.3",
    "babel-preset-expo": "~57.0.13",
    "jest": "^30.2.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.5",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "typescript": "$typescript"
  }
}
